<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/top_rule"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/timer_toggle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="Timer off"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="10dp"
                android:src="@drawable/ic_timer_off"
                android:stateListAnimator="@null"
                android:tint="@color/ink" />

            <TextView
                android:id="@+id/timer_badge"
                android:layout_width="24dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="11sp"
                android:textStyle="bold"
                android:translationX="18dp"
                android:translationY="10dp"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/zoom_toggle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Show zoom controls"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="10dp"
            android:src="@drawable/ic_zoom"
            android:stateListAnimator="@null"
            android:tint="@color/ink" />

        <ImageButton
            android:id="@+id/exposure_toggle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Show exposure controls"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="10dp"
            android:src="@drawable/ic_exposure"
            android:stateListAnimator="@null"
            android:tint="@color/ink" />

        <ImageButton
            android:id="@+id/flash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Flash off"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="10dp"
            android:src="@drawable/ic_flash_off"
            android:stateListAnimator="@null"
            android:tint="@color/ink" />

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Settings"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            android:stateListAnimator="@null"
            android:tint="@color/ink" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/camera_background">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/camera_background" />

        <TextView
            android:id="@+id/camera_loading"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="Camera loading"
            android:gravity="center"
            android:text="•••"
            android:textColor="@color/paper"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@color/paper"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="180dp"
            android:paddingHorizontal="8dp"
            android:textColor="@color/mid_ink"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/control_area"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@drawable/top_rule">

        <LinearLayout
            android:id="@+id/capture_controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <ImageButton
                android:id="@+id/gallery"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/circle_outline"
                android:contentDescription="Open gallery"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="18dp"
                android:src="@drawable/ic_gallery"
                android:stateListAnimator="@null"
                android:tint="@color/ink" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/shutter"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/shutter_button"
                android:contentDescription="Take photo"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="25dp"
                android:src="@drawable/ic_photo"
                android:stateListAnimator="@null"
                android:tint="@color/paper" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/mode"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/circle_outline"
                android:contentDescription="Switch to video mode"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="18dp"
                android:src="@drawable/ic_video"
                android:stateListAnimator="@null"
                android:tint="@color/ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/zoom_controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="28dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/zoom_out"
                android:layout_width="64dp"
                android:layout_height="72dp"
                android:background="@android:color/transparent"
                android:contentDescription="Zoom out"
                android:padding="20dp"
                android:src="@drawable/ic_remove"
                android:tint="@color/ink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/zoom_label"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="1.0×"
                    android:textColor="@color/ink"
                    android:textSize="17sp" />

                <SeekBar
                    android:id="@+id/zoom_bar"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:max="1000" />

                <com.domonation.camera.TickMarkView
                    android:id="@+id/zoom_ticks"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/zoom_in"
                android:layout_width="64dp"
                android:layout_height="72dp"
                android:background="@android:color/transparent"
                android:contentDescription="Zoom in"
                android:padding="20dp"
                android:src="@drawable/ic_add"
                android:tint="@color/ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/exposure_controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="28dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/exposure_down"
                android:layout_width="64dp"
                android:layout_height="72dp"
                android:background="@android:color/transparent"
                android:contentDescription="Decrease exposure"
                android:padding="18dp"
                android:src="@drawable/ic_remove"
                android:tint="@color/ink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exposure_label"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="+0"
                    android:textColor="@color/ink"
                    android:textSize="17sp" />

                <SeekBar
                    android:id="@+id/exposure"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:max="6"
                    android:progress="3" />

                <com.domonation.camera.TickMarkView
                    android:id="@+id/exposure_ticks"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/exposure_up"
                android:layout_width="64dp"
                android:layout_height="72dp"
                android:background="@android:color/transparent"
                android:contentDescription="Increase exposure"
                android:padding="18dp"
                android:src="@drawable/ic_add"
                android:tint="@color/ink" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
