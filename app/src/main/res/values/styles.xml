<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DomonationCamera" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/lato_regular</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowActivityTransitions">false</item>
    </style>

    <style name="Theme.DomonationCamera.Splash" parent="Theme.DomonationCamera">
        <item name="android:windowBackground">@drawable/splash_screen_legacy</item>
        <item name="android:windowDisablePreview">false</item>
    </style>
</resources>
